{"input": {"engine": "jacc", "_script": "import Pkg\nhaskey(Pkg.project().dependencies, \"JACC\") || Pkg.add(name = \"JACC\", version = \"1\")\nhaskey(Pkg.project().dependencies, \"Atomix\") || Pkg.add(\"Atomix\")\nusing CUDA\nimport JACC\nimport Atomix\nJACC.@init_backend\n\nusing JSON3\n\nfunction initstacks_halo_assembly_b(n_a, n_b, n_cell)\n    buf_stack = Vector{Float64}(undef, max(0, div(n_cell - 1, 1) + 1) * max(0, div(n_a - 1, 1) + 1) + max(0, div(n_cell - 1, 1) + 1) * max(0, div(n_b - 1, 1) + 1))\n    return buf_stack\nend\n\nfunction halo_assembly_hv(out, outb, u, ub, w, wb, b, bb, buf, bufb, n_cell, n_a, n_b, n_out, outd, outbd, ud, ubd, wd, wbd, bd, bbd, bufd, bufbd, buf_stack)\n    buf_stack_d = Vector{Float64}(undef, length(buf_stack))\n    s = 0.0\n    sb = 0.0\n    sd = 0.0\n    sbd = 0.0\n    n_w = n_a + n_b\n    for c = 1:n_cell\n        off = c * n_w\n        prev = (c - 1) * n_w\n        for k = 1:n_a\n            buf_stack_d[((c - 1) * (div(n_a - 1, 1) + 1) + (k - 1)) + 1] = bufd[off + k]\n            buf_stack[((c - 1) * (div(n_a - 1, 1) + 1) + (k - 1)) + 1] = buf[off + k]\n            bufd[off + k] = ud[(c - 1) * n_a + k]\n            buf[off + k] = u[(c - 1) * n_a + k]\n        end\n        for k = 1:n_b\n            buf_stack_d[max(0, div(n_cell - 1, 1) + 1) * max(0, div(n_a - 1, 1) + 1) + (((c - 1) * (div(n_b - 1, 1) + 1) + (k - 1)) + 1)] = bufd[off + n_a + k]\n            buf_stack[max(0, div(n_cell - 1, 1) + 1) * max(0, div(n_a - 1, 1) + 1) + (((c - 1) * (div(n_b - 1, 1) + 1) + (k - 1)) + 1)] = buf[off + n_a + k]\n            bufd[off + n_a + k] = 0.5 * ud[(c - 1) * n_a + 1]\n            buf[off + n_a + k] = u[(c - 1) * n_a + 1] * 0.5\n        end\n        for o = 1:n_out\n            sd = bd[o]\n            s = b[o]\n            for i_i = 1:n_w\n                sd = sd + (buf[prev + i_i] * wd[(o - 1) * n_w + i_i] + w[(o - 1) * n_w + i_i] * bufd[prev + i_i])\n                s = s + w[(o - 1) * n_w + i_i] * buf[prev + i_i]\n            end\n            outd[(c - 1) * n_out + o] = sd\n            out[(c - 1) * n_out + o] = s\n        end\n    end\n    n_w = n_a + n_b\n    for c = n_cell:-1:1\n        off = c * n_w\n        prev = (c - 1) * n_w\n        for o = n_out:-1:1\n            sbd = sbd + outbd[(c - 1) * n_out + o]\n            sb = sb + outb[(c - 1) * n_out + o]\n            outbd[(c - 1) * n_out + o] = 0.0\n            outb[(c - 1) * n_out + o] = 0.0\n            for i_i = n_w:-1:1\n                wbd[(o - 1) * n_w + i_i] = wbd[(o - 1) * n_w + i_i] + (sb * bufd[prev + i_i] + buf[prev + i_i] * sbd)\n                wb[(o - 1) * n_w + i_i] = wb[(o - 1) * n_w + i_i] + buf[prev + i_i] * sb\n                bufbd[prev + i_i] = bufbd[prev + i_i] + (sb * wd[(o - 1) * n_w + i_i] + w[(o - 1) * n_w + i_i] * sbd)\n                bufb[prev + i_i] = bufb[prev + i_i] + w[(o - 1) * n_w + i_i] * sb\n            end\n            bbd[o] = bbd[o] + sbd\n            bb[o] = bb[o] + sb\n            sbd = 0.0\n            sb = 0.0\n        end\n        for k = n_b:-1:1\n            bufd[off + n_a + k] = buf_stack_d[max(0, div(n_cell - 1, 1) + 1) * max(0, div(n_a - 1, 1) + 1) + (((c - 1) * (div(n_b - 1, 1) + 1) + (k - 1)) + 1)]\n            buf[off + n_a + k] = buf_stack[max(0, div(n_cell - 1, 1) + 1) * max(0, div(n_a - 1, 1) + 1) + (((c - 1) * (div(n_b - 1, 1) + 1) + (k - 1)) + 1)]\n            ubd[(c - 1) * n_a + 1] = ubd[(c - 1) * n_a + 1] + 0.5 * bufbd[off + n_a + k]\n            ub[(c - 1) * n_a + 1] = ub[(c - 1) * n_a + 1] + 0.5 * bufb[off + n_a + k]\n            bufbd[off + n_a + k] = 0.0\n            bufb[off + n_a + k] = 0.0\n        end\n        for k = n_a:-1:1\n            bufd[off + k] = buf_stack_d[((c - 1) * (div(n_a - 1, 1) + 1) + (k - 1)) + 1]\n            buf[off + k] = buf_stack[((c - 1) * (div(n_a - 1, 1) + 1) + (k - 1)) + 1]\n            ubd[(c - 1) * n_a + k] = ubd[(c - 1) * n_a + k] + bufbd[off + k]\n            ub[(c - 1) * n_a + k] = ub[(c - 1) * n_a + k] + bufb[off + k]\n            bufbd[off + k] = 0.0\n            bufb[off + k] = 0.0\n        end\n    end\n    return nothing\nend\n\nfunction initstacks_halo_assembly_b_jacc(n_a, n_b, n_cell)\n    buf_stack = JACC.zeros(Float64, max(0, div(n_cell - 1, 1) + 1) * max(0, div(n_a - 1, 1) + 1) + max(0, div(n_cell - 1, 1) + 1) * max(0, div(n_b - 1, 1) + 1))\n    return buf_stack\nend\n\nfunction halo_assembly_hv_jacc(out, outb, u, ub, w, wb, b, bb, buf, bufb, n_cell, n_a, n_b, n_out, outd, outbd, ud, ubd, wd, wbd, bd, bbd, bufd, bufbd, buf_stack)\n    buf_stack_d = JACC.zeros(Float64, length(buf_stack))\n    s = 0.0\n    sb = 0.0\n    sd = 0.0\n    sbd = 0.0\n    n_w = n_a + n_b\n    for c = 1:n_cell\n        off = c * n_w\n        prev = (c - 1) * n_w\n        if div(n_a - 1, 1) + 1 > 0\n            JACC.@parallel_for range = div(n_a - 1, 1) + 1 jacc_kernel_halo_assembly_hv_1!(buf, buf_stack, buf_stack_d, bufd, c, n_a, off, u, ud)\n        end\n        if div(n_b - 1, 1) + 1 > 0\n            JACC.@parallel_for range = div(n_b - 1, 1) + 1 jacc_kernel_halo_assembly_hv_2!(buf, buf_stack, buf_stack_d, bufd, c, n_a, n_b, n_cell, off, u, ud)\n        end\n        if div(n_out - 1, 1) + 1 > 0\n            JACC.@parallel_for range = div(n_out - 1, 1) + 1 jacc_kernel_halo_assembly_hv_3!(b, bd, buf, bufd, c, n_out, n_w, out, outd, prev, w, wd)\n        end\n    end\n    n_w = n_a + n_b\n    for c = n_cell:-1:1\n        off = c * n_w\n        prev = (c - 1) * n_w\n        if div(1 - n_out, -1) + 1 > 0\n            JACC.@parallel_for range = div(1 - n_out, -1) + 1 jacc_kernel_halo_assembly_hv_4!(bb, bbd, buf, bufb, bufbd, bufd, c, n_out, n_w, outb, outbd, prev, w, wb, wbd, wd)\n        end\n        if div(1 - n_b, -1) + 1 > 0\n            JACC.@parallel_for range = div(1 - n_b, -1) + 1 jacc_kernel_halo_assembly_hv_5!(buf, buf_stack, buf_stack_d, bufb, bufbd, bufd, c, n_a, n_b, n_cell, off, ub, ubd)\n        end\n        if div(1 - n_a, -1) + 1 > 0\n            JACC.@parallel_for range = div(1 - n_a, -1) + 1 jacc_kernel_halo_assembly_hv_6!(buf, buf_stack, buf_stack_d, bufb, bufbd, bufd, c, n_a, off, ub, ubd)\n        end\n    end\n    return nothing\nend\n\nfunction jacc_kernel_halo_assembly_hv_1!(__jacc_i, buf, buf_stack, buf_stack_d, bufd, c, n_a, off, u, ud)\n    k = 1 + (__jacc_i - 1)\n    buf_stack_d[((c - 1) * (div(n_a - 1, 1) + 1) + (k - 1)) + 1] = bufd[off + k]\n    buf_stack[((c - 1) * (div(n_a - 1, 1) + 1) + (k - 1)) + 1] = buf[off + k]\n    bufd[off + k] = ud[(c - 1) * n_a + k]\n    buf[off + k] = u[(c - 1) * n_a + k]\n    return nothing\nend\n\nfunction jacc_kernel_halo_assembly_hv_2!(__jacc_i, buf, buf_stack, buf_stack_d, bufd, c, n_a, n_b, n_cell, off, u, ud)\n    k = 1 + (__jacc_i - 1)\n    buf_stack_d[max(0, div(n_cell - 1, 1) + 1) * max(0, div(n_a - 1, 1) + 1) + (((c - 1) * (div(n_b - 1, 1) + 1) + (k - 1)) + 1)] = bufd[off + n_a + k]\n    buf_stack[max(0, div(n_cell - 1, 1) + 1) * max(0, div(n_a - 1, 1) + 1) + (((c - 1) * (div(n_b - 1, 1) + 1) + (k - 1)) + 1)] = buf[off + n_a + k]\n    bufd[off + n_a + k] = 0.5 * ud[(c - 1) * n_a + 1]\n    buf[off + n_a + k] = u[(c - 1) * n_a + 1] * 0.5\n    return nothing\nend\n\nfunction jacc_kernel_halo_assembly_hv_3!(__jacc_i, b, bd, buf, bufd, c, n_out, n_w, out, outd, prev, w, wd)\n    o = 1 + (__jacc_i - 1)\n    sd = bd[o]\n    s = b[o]\n    for i_i = 1:n_w\n        sd = sd + (buf[prev + i_i] * wd[(o - 1) * n_w + i_i] + w[(o - 1) * n_w + i_i] * bufd[prev + i_i])\n        s = s + w[(o - 1) * n_w + i_i] * buf[prev + i_i]\n    end\n    outd[(c - 1) * n_out + o] = sd\n    out[(c - 1) * n_out + o] = s\n    return nothing\nend\n\nfunction jacc_kernel_halo_assembly_hv_4!(__jacc_i, bb, bbd, buf, bufb, bufbd, bufd, c, n_out, n_w, outb, outbd, prev, w, wb, wbd, wd)\n    o = n_out + (__jacc_i - 1) * -1\n    sbd = 0.0\n    sb = 0.0\n    sbd = sbd + outbd[(c - 1) * n_out + o]\n    sb = sb + outb[(c - 1) * n_out + o]\n    outbd[(c - 1) * n_out + o] = 0.0\n    outb[(c - 1) * n_out + o] = 0.0\n    for i_i = n_w:-1:1\n        wbd[(o - 1) * n_w + i_i] = wbd[(o - 1) * n_w + i_i] + (sb * bufd[prev + i_i] + buf[prev + i_i] * sbd)\n        wb[(o - 1) * n_w + i_i] = wb[(o - 1) * n_w + i_i] + buf[prev + i_i] * sb\n        Atomix.@atomic bufbd[prev + i_i] += sb * wd[(o - 1) * n_w + i_i] + w[(o - 1) * n_w + i_i] * sbd\n        Atomix.@atomic bufb[prev + i_i] += w[(o - 1) * n_w + i_i] * sb\n    end\n    bbd[o] = bbd[o] + sbd\n    bb[o] = bb[o] + sb\n    sbd = 0.0\n    sb = 0.0\n    return nothing\nend\n\nfunction jacc_kernel_halo_assembly_hv_5!(__jacc_i, buf, buf_stack, buf_stack_d, bufb, bufbd, bufd, c, n_a, n_b, n_cell, off, ub, ubd)\n    k = n_b + (__jacc_i - 1) * -1\n    bufd[off + n_a + k] = buf_stack_d[max(0, div(n_cell - 1, 1) + 1) * max(0, div(n_a - 1, 1) + 1) + (((c - 1) * (div(n_b - 1, 1) + 1) + (k - 1)) + 1)]\n    buf[off + n_a + k] = buf_stack[max(0, div(n_cell - 1, 1) + 1) * max(0, div(n_a - 1, 1) + 1) + (((c - 1) * (div(n_b - 1, 1) + 1) + (k - 1)) + 1)]\n    Atomix.@atomic ubd[(c - 1) * n_a + 1] += 0.5 * bufbd[off + n_a + k]\n    Atomix.@atomic ub[(c - 1) * n_a + 1] += 0.5 * bufb[off + n_a + k]\n    bufbd[off + n_a + k] = 0.0\n    bufb[off + n_a + k] = 0.0\n    return nothing\nend\n\nfunction jacc_kernel_halo_assembly_hv_6!(__jacc_i, buf, buf_stack, buf_stack_d, bufb, bufbd, bufd, c, n_a, off, ub, ubd)\n    k = n_a + (__jacc_i - 1) * -1\n    bufd[off + k] = buf_stack_d[((c - 1) * (div(n_a - 1, 1) + 1) + (k - 1)) + 1]\n    buf[off + k] = buf_stack[((c - 1) * (div(n_a - 1, 1) + 1) + (k - 1)) + 1]\n    ubd[(c - 1) * n_a + k] = ubd[(c - 1) * n_a + k] + bufbd[off + k]\n    ub[(c - 1) * n_a + k] = ub[(c - 1) * n_a + k] + bufb[off + k]\n    bufbd[off + k] = 0.0\n    bufb[off + k] = 0.0\n    return nothing\nend\n\nfunction _val_init_stacks_local(fn, extra_args)\n    r = fn(extra_args...)\n    r === nothing && return ()\n    r isa Tuple && return r\n    return (r,)\nend\n\n_relerr_scalar(a, b) = abs(a - b) / max(abs(a), abs(b), 1.0)\n_relerr_arr(a, b) = maximum(abs.(a .- b) ./ max.(abs.(a), abs.(b), 1.0); init = 0.0)\n\nfunction _val_stack_relerr(cpu_stacks, gpu_stacks)\n    worst = 0.0\n    n = 0\n    for (c, g) in zip(cpu_stacks, gpu_stacks)\n        (c isa AbstractArray && g isa AbstractArray) || continue\n        eltype(c) <: AbstractFloat || continue\n        a = Array(g)\n        length(c) == length(a) || continue\n        n += 1\n        worst = max(worst, _relerr_arr(c, a))\n    end\n    return (worst, n)\nend\n\nn_cell = 4\nn_a = 4\nn_b = 2\nn_out = 3\n__base_out = Float64[1.4520067746933871, 0.35004711601986693, 0.8640199636444473, -0.48936385910957614, -0.6530638415268368, 0.08645597336560568, -1.816519925345924, -0.6495470484633882, 0.04644699363363338, -0.7122362699054544, -1.2764574215503404, 1.5507212511318584, -0.20563730461663055, 1.1472677004948781, -0.4131830220855397, 1.2757260052449129, -0.21901141324601184, -0.5109289005043477, 0.4421241673609355, 1.172870657684656, -0.7965556269607851, -0.7789425038428398, 0.3166417678607726, 1.225437074859651, -1.0746664258550631, 0.7221866043510125, -0.3197065120184748, -0.7099655150955435, 0.5442921084784956, 0.2890301583919947, -0.8461177060526061, 0.7082718119083342]\n__base_u = Float64[0.8479950220784327, -1.637838754161831, -0.953346505889736, -0.2979767041343774, -0.26824224103021543, -0.24857296935576847, 0.20614538966201773, 0.8119355031635028, 0.9557656499038132, -1.4505821777684853, 0.28288958688203947, 0.3656797333900268, 0.2897367484681434, 0.8946336153928439, -1.001769182347213, 0.10266156988664726, 0.4423157859828604, 0.5434277718364431, -2.32130641853812, -1.1488613143450843, -0.8698836868302507, 0.40939273935508413, -0.34311216197059147, -0.02154716399454639, 0.9762082766075563, -1.4683427809735472, 0.17984227454011742, -0.8884350750434318, 0.3532847496103679, 1.4691245943492026, -0.3870087368019111, 1.5283793746065124]\n__base_w = Float64[-0.7533323408837309, 1.40291337601058, 0.0058801717925870255, 0.9149179220612463, -1.3083371703246993, 0.18926545049706772, 0.043897360295118704, -1.00