{"input": {"engine": "cuda", "_script": "import Pkg\nhaskey(Pkg.project().dependencies, \"CUDA\") || Pkg.add(\"CUDA\")\nusing CUDA\nusing LinearAlgebra\nCUDA.allowscalar(false)\n\nusing JSON3\n\nfunction initstacks_halo_assembly_b(n_a, n_b, n_cell)\n    buf_stack = Vector{Float64}(undef, max(0, div(n_cell - 1, 1) + 1) * max(0, div(n_a - 1, 1) + 1) + max(0, div(n_cell - 1, 1) + 1) * max(0, div(n_b - 1, 1) + 1))\n    return buf_stack\nend\n\nfunction halo_assembly_b(out, outb, u, ub, w, wb, b, bb, buf, bufb, n_cell, n_a, n_b, n_out, buf_stack)\n    s = 0.0\n    sb = 0.0\n    n_w = n_a + n_b\n    for c = 1:n_cell\n        off = c * n_w\n        prev = (c - 1) * n_w\n        for k = 1:n_a\n            buf_stack[((c - 1) * (div(n_a - 1, 1) + 1) + (k - 1)) + 1] = buf[off + k]\n            buf[off + k] = u[(c - 1) * n_a + k]\n        end\n        for k = 1:n_b\n            buf_stack[max(0, div(n_cell - 1, 1) + 1) * max(0, div(n_a - 1, 1) + 1) + (((c - 1) * (div(n_b - 1, 1) + 1) + (k - 1)) + 1)] = buf[off + n_a + k]\n            buf[off + n_a + k] = u[(c - 1) * n_a + 1] * 0.5\n        end\n        for o = 1:n_out\n            s = b[o]\n            for i_i = 1:n_w\n                s = s + w[(o - 1) * n_w + i_i] * buf[prev + i_i]\n            end\n            out[(c - 1) * n_out + o] = s\n        end\n    end\n    n_w = n_a + n_b\n    for c = n_cell:-1:1\n        off = c * n_w\n        prev = (c - 1) * n_w\n        for o = n_out:-1:1\n            sb = sb + outb[(c - 1) * n_out + o]\n            outb[(c - 1) * n_out + o] = 0.0\n            for i_i = n_w:-1:1\n                wb[(o - 1) * n_w + i_i] = wb[(o - 1) * n_w + i_i] + buf[prev + i_i] * sb\n                bufb[prev + i_i] = bufb[prev + i_i] + w[(o - 1) * n_w + i_i] * sb\n            end\n            bb[o] = bb[o] + sb\n            sb = 0.0\n        end\n        for k = n_b:-1:1\n            buf[off + n_a + k] = buf_stack[max(0, div(n_cell - 1, 1) + 1) * max(0, div(n_a - 1, 1) + 1) + (((c - 1) * (div(n_b - 1, 1) + 1) + (k - 1)) + 1)]\n            ub[(c - 1) * n_a + 1] = ub[(c - 1) * n_a + 1] + 0.5 * bufb[off + n_a + k]\n            bufb[off + n_a + k] = 0.0\n        end\n        for k = n_a:-1:1\n            buf[off + k] = buf_stack[((c - 1) * (div(n_a - 1, 1) + 1) + (k - 1)) + 1]\n            ub[(c - 1) * n_a + k] = ub[(c - 1) * n_a + k] + bufb[off + k]\n            bufb[off + k] = 0.0\n        end\n    end\n    return nothing\nend\n\nfunction initstacks_halo_assembly_b_cuda(n_a, n_b, n_cell)\n    buf_stack = CuArray{Float64}(undef, max(0, div(n_cell - 1, 1) + 1) * max(0, div(n_a - 1, 1) + 1) + max(0, div(n_cell - 1, 1) + 1) * max(0, div(n_b - 1, 1) + 1))\n    return buf_stack\nend\n\nfunction halo_assembly_b_cuda(out, outb, u, ub, w, wb, b, bb, buf, bufb, n_cell, n_a, n_b, n_out, buf_stack)\n    nthread_per_block = 256\n    s = 0.0\n    sb = 0.0\n    n_w = n_a + n_b\n    for c = 1:n_cell\n        off = c * n_w\n        prev = (c - 1) * n_w\n        @cuda threads = nthread_per_block blocks = max(1, cld(div(n_a - 1, 1) + 1, nthread_per_block)) cuda_kernel_halo_assembly_b_1!(buf, buf_stack, c, n_a, off, u)\n        @cuda threads = nthread_per_block blocks = max(1, cld(div(n_b - 1, 1) + 1, nthread_per_block)) cuda_kernel_halo_assembly_b_2!(buf, buf_stack, c, n_a, n_b, n_cell, off, u)\n        @cuda threads = nthread_per_block blocks = max(1, cld(div(n_out - 1, 1) + 1, nthread_per_block)) cuda_kernel_halo_assembly_b_3!(b, buf, c, n_out, n_w, out, prev, w)\n    end\n    n_w = n_a + n_b\n    for c = n_cell:-1:1\n        off = c * n_w\n        prev = (c - 1) * n_w\n        @cuda threads = nthread_per_block blocks = max(1, cld(div(1 - n_out, -1) + 1, nthread_per_block)) cuda_kernel_halo_assembly_b_4!(bb, buf, bufb, c, n_out, n_w, outb, prev, w, wb)\n        @cuda threads = nthread_per_block blocks = max(1, cld(div(1 - n_b, -1) + 1, nthread_per_block)) cuda_kernel_halo_assembly_b_5!(buf, buf_stack, bufb, c, n_a, n_b, n_cell, off, ub)\n        @cuda threads = nthread_per_block blocks = max(1, cld(div(1 - n_a, -1) + 1, nthread_per_block)) cuda_kernel_halo_assembly_b_6!(buf, buf_stack, bufb, c, n_a, off, ub)\n    end\n    return nothing\nend\n\nfunction cuda_kernel_halo_assembly_b_1!(buf, buf_stack, c, n_a, off, u)\n    __tid = ((blockIdx()).x - 1) * (blockDim()).x + (threadIdx()).x\n    if __tid > div(n_a - 1, 1) + 1\n        return nothing\n    end\n    k = 1 + (__tid - 1)\n    buf_stack[((c - 1) * (div(n_a - 1, 1) + 1) + (k - 1)) + 1] = buf[off + k]\n    buf[off + k] = u[(c - 1) * n_a + k]\n    return nothing\nend\n\nfunction cuda_kernel_halo_assembly_b_2!(buf, buf_stack, c, n_a, n_b, n_cell, off, u)\n    __tid = ((blockIdx()).x - 1) * (blockDim()).x + (threadIdx()).x\n    if __tid > div(n_b - 1, 1) + 1\n        return nothing\n    end\n    k = 1 + (__tid - 1)\n    buf_stack[max(0, div(n_cell - 1, 1) + 1) * max(0, div(n_a - 1, 1) + 1) + (((c - 1) * (div(n_b - 1, 1) + 1) + (k - 1)) + 1)] = buf[off + n_a + k]\n    buf[off + n_a + k] = u[(c - 1) * n_a + 1] * 0.5\n    return nothing\nend\n\nfunction cuda_kernel_halo_assembly_b_3!(b, buf, c, n_out, n_w, out, prev, w)\n    __tid = ((blockIdx()).x - 1) * (blockDim()).x + (threadIdx()).x\n    if __tid > div(n_out - 1, 1) + 1\n        return nothing\n    end\n    o = 1 + (__tid - 1)\n    s = b[o]\n    for i_i = 1:n_w\n        s = s + w[(o - 1) * n_w + i_i] * buf[prev + i_i]\n    end\n    out[(c - 1) * n_out + o] = s\n    return nothing\nend\n\nfunction cuda_kernel_halo_assembly_b_4!(bb, buf, bufb, c, n_out, n_w, outb, prev, w, wb)\n    __tid = ((blockIdx()).x - 1) * (blockDim()).x + (threadIdx()).x\n    if __tid > div(1 - n_out, -1) + 1\n        return nothing\n    end\n    o = n_out + (__tid - 1) * -1\n    sb = 0.0\n    sb = sb + outb[(c - 1) * n_out + o]\n    outb[(c - 1) * n_out + o] = 0.0\n    for i_i = n_w:-1:1\n        wb[(o - 1) * n_w + i_i] = wb[(o - 1) * n_w + i_i] + buf[prev + i_i] * sb\n        CUDA.@atomic bufb[prev + i_i] += w[(o - 1) * n_w + i_i] * sb\n    end\n    bb[o] = bb[o] + sb\n    sb = 0.0\n    return nothing\nend\n\nfunction cuda_kernel_halo_assembly_b_5!(buf, buf_stack, bufb, c, n_a, n_b, n_cell, off, ub)\n    __tid = ((blockIdx()).x - 1) * (blockDim()).x + (threadIdx()).x\n    if __tid > div(1 - n_b, -1) + 1\n        return nothing\n    end\n    k = n_b + (__tid - 1) * -1\n    buf[off + n_a + k] = buf_stack[max(0, div(n_cell - 1, 1) + 1) * max(0, div(n_a - 1, 1) + 1) + (((c - 1) * (div(n_b - 1, 1) + 1) + (k - 1)) + 1)]\n    CUDA.@atomic ub[(c - 1) * n_a + 1] += 0.5 * bufb[off + n_a + k]\n    bufb[off + n_a + k] = 0.0\n    return nothing\nend\n\nfunction cuda_kernel_halo_assembly_b_6!(buf, buf_stack, bufb, c, n_a, off, ub)\n    __tid = ((blockIdx()).x - 1) * (blockDim()).x + (threadIdx()).x\n    if __tid > div(1 - n_a, -1) + 1\n        return nothing\n    end\n    k = n_a + (__tid - 1) * -1\n    buf[off + k] = buf_stack[((c - 1) * (div(n_a - 1, 1) + 1) + (k - 1)) + 1]\n    ub[(c - 1) * n_a + k] = ub[(c - 1) * n_a + k] + bufb[off + k]\n    bufb[off + k] = 0.0\n    return nothing\nend\n\nfunction _val_init_stacks_local(fn, extra_args)\n    r = fn(extra_args...)\n    r === nothing && return ()\n    r isa Tuple && return r\n    return (r,)\nend\n\n_relerr_scalar(a, b) = abs(a - b) / max(abs(a), abs(b), 1.0)\n_relerr_arr(a, b) = maximum(abs.(a .- b) ./ max.(abs.(a), abs.(b), 1.0); init = 0.0)\n\nfunction _val_stack_relerr(cpu_stacks, gpu_stacks)\n    worst = 0.0\n    n = 0\n    for (c, g) in zip(cpu_stacks, gpu_stacks)\n        (c isa AbstractArray && g isa AbstractArray) || continue\n        eltype(c) <: AbstractFloat || continue\n        a = Array(g)\n        length(c) == length(a) || continue\n        n += 1\n        worst = max(worst, _relerr_arr(c, a))\n    end\n    return (worst, n)\nend\n\nn_cell = 4\nn_a = 4\nn_b = 2\nn_out = 3\n__base_out = Float64[1.4520067746933871, 0.35004711601986693, 0.8640199636444473, -0.48936385910957614, -0.6530638415268368, 0.08645597336560568, -1.816519925345924, -0.6495470484633882, 0.04644699363363338, -0.712236