{"input": {"engine": "gpu-parity-check", "_script": "import Pkg\nhaskey(Pkg.project().dependencies, \"CUDA\") || Pkg.add(\"CUDA\")\nusing CUDA\nusing LinearAlgebra\nCUDA.allowscalar(false)\n\nusing JSON3\n\nfunction initstacks_matvec_loss_b()\n    return nothing\nend\n\nfunction matvec_loss_b(loss, lossb, a, ab, u, ub, v, vb, i_m, i_n)\n    for i_i = 1:i_m\n        for i_seq_j = 1:i_n\n            v[i_i] = v[i_i] + a[i_i, i_seq_j] * u[i_seq_j]\n        end\n    end\n    for i_seq_i = 1:i_m\n        loss[1] = loss[1] + v[i_seq_i] ^ 2\n    end\n    for i_seq_i = i_m:-1:1\n        vb[i_seq_i] = vb[i_seq_i] + (2 * v[i_seq_i]) * lossb[1]\n    end\n    for i_i = 1:i_m\n        for i_seq_j = i_n:-1:1\n            ab[i_i, i_seq_j] = ab[i_i, i_seq_j] + u[i_seq_j] * vb[i_i]\n            ub[i_seq_j] = ub[i_seq_j] + a[i_i, i_seq_j] * vb[i_i]\n        end\n    end\n    return nothing\nend\n\nfunction initstacks_matvec_loss_b_cuda()\n    return nothing\nend\n\nfunction matvec_loss_b_cuda(loss, lossb, a, ab, u, ub, v, vb, i_m, i_n)\n    nthread_per_block = 256\n    @cuda threads = nthread_per_block blocks = cld(div(i_m - 1, 1) + 1, nthread_per_block) cuda_kernel_matvec_loss_b_1!(a, i_m, i_n, u, v)\n    @cuda threads = nthread_per_block blocks = cld(div(i_m - 1, 1) + 1, nthread_per_block) cuda_kernel_matvec_loss_b_2!(i_m, loss, v)\n    @cuda threads = nthread_per_block blocks = cld(div(1 - i_m, -1) + 1, nthread_per_block) cuda_kernel_matvec_loss_b_3!(i_m, lossb, v, vb)\n    @cuda threads = nthread_per_block blocks = cld(div(i_m - 1, 1) + 1, nthread_per_block) cuda_kernel_matvec_loss_b_4!(a, ab, i_m, i_n, u, ub, vb)\n    return nothing\nend\n\nfunction cuda_kernel_matvec_loss_b_1!(a, i_m, i_n, u, v)\n    __tid = ((blockIdx()).x - 1) * (blockDim()).x + (threadIdx()).x\n    if __tid > div(i_m - 1, 1) + 1\n        return nothing\n    end\n    i_i = 1 + (__tid - 1)\n    for i_seq_j = 1:i_n\n        v[i_i] = v[i_i] + a[i_i, i_seq_j] * u[i_seq_j]\n    end\n    return nothing\nend\n\nfunction cuda_kernel_matvec_loss_b_2!(i_m, loss, v)\n    __tid = ((blockIdx()).x - 1) * (blockDim()).x + (threadIdx()).x\n    if __tid > div(i_m - 1, 1) + 1\n        return nothing\n    end\n    i_seq_i = 1 + (__tid - 1)\n    CUDA.@atomic loss[1] += v[i_seq_i] ^ 2\n    return nothing\nend\n\nfunction cuda_kernel_matvec_loss_b_3!(i_m, lossb, v, vb)\n    __tid = ((blockIdx()).x - 1) * (blockDim()).x + (threadIdx()).x\n    if __tid > div(1 - i_m, -1) + 1\n        return nothing\n    end\n    i_seq_i = i_m + (__tid - 1) * -1\n    vb[i_seq_i] = vb[i_seq_i] + (2 * v[i_seq_i]) * lossb[1]\n    return nothing\nend\n\nfunction cuda_kernel_matvec_loss_b_4!(a, ab, i_m, i_n, u, ub, vb)\n    __tid = ((blockIdx()).x - 1) * (blockDim()).x + (threadIdx()).x\n    if __tid > div(i_m - 1, 1) + 1\n        return nothing\n    end\n    i_i = 1 + (__tid - 1)\n    for i_seq_j = i_n:-1:1\n        ab[i_i, i_seq_j] = ab[i_i, i_seq_j] + u[i_seq_j] * vb[i_i]\n        CUDA.@atomic ub[i_seq_j] += a[i_i, i_seq_j] * vb[i_i]\n    end\n    return nothing\nend\n\nfunction _val_init_stacks_local(fn, extra_args)\n    r = fn(extra_args...)\n    r === nothing && return ()\n    r isa Tuple && return r\n    return (r,)\nend\n\n_relerr_scalar(a, b) = abs(a - b) / max(abs(a), abs(b), 1.0)\n_relerr_arr(a, b) = maximum(abs.(a .- b) ./ max.(abs.(a), abs.(b), 1.0))\n\ni_m = 5\ni_n = 5\n__base_loss = Float64[-0.4957370575874993, 0.5065871209575573, 1.129562985291959, -0.6679442522717494, 1.9344810669847627, 1.1755214940555267, 0.3254868266947134, 0.9775233151760121]\n__base_a = Float64[-0.3326118883912149 1.0015926167731244 -0.9718610041218992 -0.6438335381461905 0.8685910084879732 -0.20094280955913196 -1.1789697670254604 0.7943275596252002; -0.9183357007990778 -0.19679124650948385 0.9373639312815603 -0.28088598739757287 0.008959890475903221 -0.05362218965660569 -1.090843100395241 -0.7424142427295026; 0.2804307006374999 -1.2434853679351914 -0.05683732852912778 0.434500795705345 -0.2560069078790813 -2.2875976176813317 0.